# BIS Saarthi AI / BISynapse Backend — Environment Variables
# Copy to backend/.env for local backend development. Do not commit actual secrets.

PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Supabase PostgreSQL Database (Optional for Cloud DB) ────
# Get these from your Supabase Project Settings -> API & Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=your_gemini_api_key_here