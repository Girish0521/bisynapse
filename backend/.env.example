# Copy to .env locally. Do not commit real values.
PORT=4000
ENABLE_SUPABASE=false
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Administrative credentials must remain server-only. Leave unset until
# server authorization and private-data ownership protections are implemented.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only LLM credentials. No public frontend variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
