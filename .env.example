# BISynapse Frontend — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Render Backend URL ──────────────────────────────────────
# Set this to your Render backend URL after deploying.
# Leave empty to use the built-in Next.js API routes (for local dev).
NEXT_PUBLIC_BACKEND_URL=

# Example (after Render deploy):
# NEXT_PUBLIC_BACKEND_URL=https://bisynapse-api.onrender.com
