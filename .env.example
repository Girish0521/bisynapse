# BIS Saarthi AI / BISynapse Frontend — Environment Variables
# Copy this file to .env.local for local development. Do not commit actual secrets.

# ── Backend URL ─────────────────────────────────────────────
# Set to your Render backend URL (e.g. https://bisynapse-api.onrender.com)
# Leave empty or set to http://localhost:4000 for local development.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# ── Supabase Configuration (Optional for Cloud DB/Auth) ────
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
